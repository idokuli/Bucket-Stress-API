# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Flask Configuration
# Required for session security. 
# You can generate a random key with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=generate_a_random_hex_string_here

# Optional: Default target bucket (for S3 Explorer)
S3_BUCKET_NAME=your-default-bucket-name

# Infrastructure Configuration (for Terraform)
TF_VAR_bucket_name=unique-bucket-name
